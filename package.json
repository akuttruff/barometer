{
  "name": "barometer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "BAROMETER_DEMO=1 vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "check": "tsc --noEmit && oxlint && vitest run",
    "deploy": "sh scripts/deploy.sh",
    "screenshots": "node scripts/screenshots.mjs",
    "seed:demo": "node --experimental-transform-types --no-warnings scripts/seed-demo.ts"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6",
    "@vitest/coverage-v8": "^5",
    "jsdom": "^30",
    "oxlint": "^1.85.0",
    "typescript": "^7",
    "vite": "^8",
    "vitest": "^5"
  }
}
